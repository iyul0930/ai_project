df = pd.DataFrame(places)

# 지도 표시
st.subheader("📍 서울 관광지 지도")

layer = pdk.Layer(
    "ScatterplotLayer",
    data=df,
    get_position='[lon, lat]',
    get_color='[255, 0, 0, 180]',
    get_radius=250,
    pickable=True
)

view_state = pdk.ViewState(
    latitude=37.5665,
    longitude=126.9780,
    zoom=11
)

tooltip = {
    "html": "<b>{name}</b>",
    "style": {
        "backgroundColor": "steelblue",
        "color": "white"
    }
}

deck = pdk.Deck(
    layers=[layer],
    initial_view_state=view_state,
    tooltip=tooltip
)

st.pydeck_chart(deck)

# 관광지 선택
st.subheader("🏙️ 관광지 정보")

selected_place = st.selectbox(
    "가고 싶은 관광지를 선택하세요",
    df["name"]
)

selected_info = df[df["name"] == selected_place].iloc[0]

st.markdown(f"### 📌 {selected_info['name']}")
st.write(selected_info["description"])
st.info(f"🚇 가까운 지하철역: {selected_info['subway']}")

st.success("서울 여행을 즐겨보세요 ✈️")
